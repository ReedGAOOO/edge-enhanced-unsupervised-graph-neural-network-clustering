+class EdgeRelationStateEncoder(nn.Module):
+    """Encode raw edge_attr into a persistent relation state: [strength, relation_probs]."""
+
+    def __init__(self, edge_attr_dim: int, num_relations: int = 4, hidden_dim: int = 64, dropout: float = 0.0):
+        super().__init__()
+        self.num_relations = max(1, int(num_relations))
+        hidden = max(8, int(hidden_dim))
+        self.out_dim = self.num_relations + 1
+        self.encoder = nn.Sequential(
+            nn.Linear(int(max(1, edge_attr_dim)), hidden),
+            nn.ReLU(),
+            nn.Dropout(dropout),
+            nn.Linear(hidden, self.out_dim),
+        )
+        self.msg_beta = nn.Parameter(torch.zeros(self.num_relations))
+        self.si_beta = nn.Parameter(torch.zeros(self.num_relations))
+
+    def _neutral_state(self, num_edges: int, dtype: torch.dtype, device: torch.device) -> torch.Tensor:
+        strength = torch.ones((num_edges, 1), dtype=dtype, device=device)
+        probs = torch.full(
+            (num_edges, self.num_relations),
+            1.0 / float(self.num_relations),
+            dtype=dtype,
+            device=device,
+        )
+        return torch.cat([strength, probs], dim=1)
+
+    def _normalize_strength(self, strength: torch.Tensor, matched: torch.Tensor | None = None) -> torch.Tensor:
+        if matched is not None and torch.any(matched):
+            ref = strength[matched].detach().mean().clamp_min(1e-4)
+        else:
+            ref = strength.detach().mean().clamp_min(1e-4)
+        return strength / ref
+
+    def encode(self, edge_attr: torch.Tensor | None, matched: torch.Tensor | None = None) -> torch.Tensor | None:
+        if edge_attr is None:
+            return None
+        if edge_attr.dim() == 1:
+            edge_attr = edge_attr.unsqueeze(1)
+        edge_attr = torch.nan_to_num(edge_attr.float(), nan=0.0, posinf=0.0, neginf=0.0)
+        raw = self.encoder(edge_attr)
+        strength = F.softplus(raw[:, :1]) + 1e-6
+        strength = self._normalize_strength(strength, matched=matched)
+        probs = torch.softmax(raw[:, 1:], dim=-1)
+        state = torch.cat([strength, probs], dim=1)
+        if matched is not None:
+            neutral = self._neutral_state(edge_attr.shape[0], dtype=state.dtype, device=state.device)
+            state = torch.where(matched.unsqueeze(1), state, neutral)
+        return state
+
+    def _head_beta(self, head: str) -> torch.Tensor:
+        base = self.msg_beta if str(head).lower() == 'msg' else self.si_beta
+        beta = F.softplus(base) + 1e-4
+        beta = beta / beta.mean().detach().clamp_min(1e-4)
+        return beta
+
+    def factor_from_state(self, edge_state: torch.Tensor | None, head: str = 'msg') -> torch.Tensor | None:
+        if edge_state is None or edge_state.numel() == 0:
+            return None
+        strength = edge_state[:, :1].clamp_min(1e-4)
+        probs = edge_state[:, 1:]
+        beta = self._head_beta(head).to(dtype=probs.dtype, device=probs.device)
+        factor = strength.squeeze(1) * torch.matmul(probs, beta)
+        return factor.clamp_min(1e-4)
+
+    def regularization(self, edge_state: torch.Tensor | None, matched: torch.Tensor | None = None) -> torch.Tensor:
+        if edge_state is None or edge_state.numel() == 0:
+            device = self.msg_beta.device
+            return torch.zeros((), dtype=self.msg_beta.dtype, device=device)
+        if matched is not None and torch.any(matched):
+            state = edge_state[matched]
+        else:
+            state = edge_state
+        strength = state[:, 0]
+        probs = state[:, 1:]
+        strength_reg = ((strength - 1.0) ** 2).mean()
+        beta_msg = self._head_beta('msg')
+        beta_si = self._head_beta('si')
+        beta_reg = ((beta_msg - 1.0) ** 2).mean() + ((beta_si - 1.0) ** 2).mean()
+        if self.num_relations > 1:
+            entropy = -(probs * torch.log(probs.clamp_min(1e-8))).sum(dim=-1)
+            entropy = entropy / math.log(float(self.num_relations))
+            entropy_reg = ((entropy - 0.5) ** 2).mean()
+        else:
+            entropy_reg = strength_reg.new_zeros(())
+        return strength_reg + 0.1 * beta_reg + 0.05 * entropy_reg
 
 
