{
  "name": "e2_synth_ctx_warm",
  "description": "Weak-feature SBM benchmark (synth_ctx_v1, feature_sep 0.35, K=4, N=2000) with the label-free SE-selected warm start. Does each model exploit direct / contextual edge semantics, and does the gain vanish under edge-attribute permutation? baseline ignores edge_attr, so it runs once per homophily level.",
  "seeds": [
    0,
    1,
    2
  ],
  "max_nums_default": 6,
  "defaults": {
    "epochs": 1500,
    "hid_dim": 512,
    "w_decay": 0.0,
    "temperature": 1.0,
    "dropout": 0.1,
    "eval_freq": 100,
    "train_log_interval": 200,
    "n_cluster_trials": 3,
    "patience": 0,
    "exp_iters": 1,
    "warm_start": "auto",
    "warm_start_epochs": 200
  },
  "jobs": [
    {
      "tag": "baseline",
      "preset": "baseline_v1",
      "datasets": [
        "synth_ctx_v1_h45_none_ds00",
        "synth_ctx_v1_h55_none_ds00"
      ]
    },
    {
      "tag": "b45",
      "preset": "b45_v31_msgcond_gs050",
      "datasets": [
        "synth_ctx_v1_h45_none_ds00",
        "synth_ctx_v1_h45_direct_ds00",
        "synth_ctx_v1_h45_direct_ds00_permEA",
        "synth_ctx_v1_h45_contextual_ds00",
        "synth_ctx_v1_h45_contextual_ds00_permEA",
        "synth_ctx_v1_h55_none_ds00",
        "synth_ctx_v1_h55_direct_ds00",
        "synth_ctx_v1_h55_direct_ds00_permEA",
        "synth_ctx_v1_h55_contextual_ds00",
        "synth_ctx_v1_h55_contextual_ds00_permEA"
      ]
    },
    {
      "tag": "ep1_ctx",
      "workspace": "results/breakthrough_v1/_code/expert1",
