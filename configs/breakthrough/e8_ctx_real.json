        2
      ],
      "datasets": [
        "cora",
        "dblp_magnn_author_v2",
        "acm_multiplex_v2"
      ],
      "overrides": {
        "warm_start": "none",
        "edge_ctx_dim": 32
      }
    },
    {
      "tag": "b31ctx_nowarm",
      "preset": "b31_dualscalar_assign",
