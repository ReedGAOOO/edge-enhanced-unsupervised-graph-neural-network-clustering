        "warm_start": "auto",
        "warm_start_epochs": 200,
        "edge_ctx_dim": 32
      }
    },
    {
      "tag": "b31ctx_nowarm",
      "preset": "b31_dualscalar_assign",
      "seeds": [
        0,
