{
  "name": "e21_few_label_dse",
  "description": "E21 method 3: few-label DSE. B31 + endpoint context with a pairwise same-cluster loss on the labeled nodes and a same-label loss on its edge-weight heads (b31ctxsup), against the edge-free baseline with the pairwise loss only (basesup). Labeled nodes are drawn by --label_seed and excluded from evaluation.",
  "seeds": [
    0
  ],
  "max_nums_default": 6,
  "max_nums": {
    "cora": 10,
    "photo": 10,
    "dblp_magnn_author_v2": 12,
    "entities_aifb": 16,
    "acm_multiplex_v2": 6
  },
  "defaults": {
    "epochs": 1000,
    "hid_dim": 512,
    "w_decay": 0.0,
    "temperature": 1.0,
    "dropout": 0.1,
    "eval_freq": 100,
    "train_log_interval": 200,
    "n_cluster_trials": 3,
    "patience": 0,
    "exp_iters": 1
  },
